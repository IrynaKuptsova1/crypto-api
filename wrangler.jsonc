{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crypto-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-09",
	"d1_databases": [
		{
			"binding": "crypto_db",
			"database_name": "crypto-db",
			"database_id": "842e405f-9d76-4ef0-9f7a-1fe568cfaafc",
			"remote": true,
      "migrations_dir": "drizzle"
		}
	],
  "triggers": {
  "crons": [
    "*/5 * * * *"
  ]
}
}